# Estado local pessoal. A pasta .data está ignorada pelo Git.
LOCAL_DATA_FILE=.data/bleedingmoney.json
BLEEDINGMONEY_DEMO=false
# Limite de confiança do proxy. Por omissão, cabeçalhos encaminhados são ignorados.
TRUST_PROXY=false
# Origem pública canónica, sem caminho. Definir no túnel/proxy de produção.
# PUBLIC_ORIGIN=https://poupancas.example.com
# auto usa HTTPS direto, PUBLIC_ORIGIN ou X-Forwarded-Proto apenas com TRUST_PROXY=true.
AUTH_COOKIE_SECURE=auto

# PostgreSQL: definir DATABASE_URL e password apenas no ambiente local/secret manager.
# DATABASE_URL=postgresql://utilizador:password@localhost:5432/poupancas
POSTGRES_USER=poupancas_dev
POSTGRES_PASSWORD=
POSTGRES_DB=poupancas
NUXT_PUBLIC_APP_NAME=BleedingMoney
